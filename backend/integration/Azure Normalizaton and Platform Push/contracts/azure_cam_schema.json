{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AzureCommonAssetModel",
  "description": "Standardized Common Asset Model (CAM) schema for Azure resource ingestion.",
  "type": "object",
  "required": [
    "asset_id",
    "name",
    "cloud_provider",
    "resource_type",
    "native_type",
    "region",
    "normalized_at",
    "attributes"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier (ARM Resource ID or Graph object ID)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Resource name or principal display name."
    },
    "cloud_provider": {
      "type": "string",
      "enum": ["azure"]
    },
    "resource_type": {
      "type": "string",
      "enum": ["compute", "storage", "identity", "database", "serverless"]
    },
    "native_type": {
      "type": "string",
      "description": "Native Azure ARM or Graph resource string (e.g. Microsoft.Compute/virtualMachines)."
    },
    "region": {
      "type": "string",
      "description": "Azure location (e.g., eastus, westeurope, global)."
    },
    "subscription_id": {
      "type": ["string", "null"],
      "description": "GUID of the target Azure subscription."
    },
    "resource_group": {
      "type": ["string", "null"],
      "description": "Target Azure resource group name."
    },
    "tags": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Resource tags as key-value string pairs."
    },
    "normalized_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of normalization."
    },
    "attributes": {
      "type": "object",
      "description": "Polymorphic sub-schema container for type-specific attributes."
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "title": "Virtual Machine (Compute) Sub-Schema",
      "properties": {
        "resource_type": { "const": "compute" },
        "attributes": {
          "type": "object",
          "required": ["os_type"],
          "properties": {
            "vm_size": { "type": ["string", "null"] },
            "os_type": { "type": "string" },
            "provisioning_state": { "type": ["string", "null"] },
            "vm_id": { "type": ["string", "null"] },
            "network_interface_ids": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "title": "Storage Account (Storage) Sub-Schema",
      "properties": {
        "resource_type": { "const": "storage" },
        "attributes": {
          "type": "object",
          "required": ["supports_https_only"],
          "properties": {
            "sku_name": { "type": ["string", "null"] },
            "sku_tier": { "type": ["string", "null"] },
            "access_tier": { "type": ["string", "null"] },
            "supports_https_only": { "type": "boolean" },
            "encryption_key_source": { "type": ["string", "null"] },
            "provisioning_state": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "title": "Entra ID / AAD (Identity) Sub-Schema",
      "properties": {
        "resource_type": { "const": "identity" },
        "attributes": {
          "type": "object",
          "required": ["object_id", "account_enabled"],
          "properties": {
            "object_id": { "type": "string" },
            "user_principal_name": { "type": ["string", "null"] },
            "display_name": { "type": ["string", "null"] },
            "account_enabled": { "type": "boolean" },
            "user_type": { "type": ["string", "null"] },
            "assigned_roles": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "title": "SQL Database (Database) Sub-Schema",
      "properties": {
        "resource_type": { "const": "database" },
        "attributes": {
          "type": "object",
          "properties": {
            "edition": { "type": ["string", "null"] },
            "sku_name": { "type": ["string", "null"] },
            "max_size_bytes": { "type": ["integer", "null"] },
            "status": { "type": ["string", "null"] },
            "collation": { "type": ["string", "null"] },
            "earliest_restore_date": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "title": "Function App (Serverless) Sub-Schema",
      "properties": {
        "resource_type": { "const": "serverless" },
        "attributes": {
          "type": "object",
          "required": ["https_only"],
          "properties": {
            "kind": { "type": ["string", "null"] },
            "state": { "type": ["string", "null"] },
            "runtime": { "type": ["string", "null"] },
            "https_only": { "type": "boolean" },
            "outbound_ip_addresses": {
              "type": "array",
              "items": { "type": "string" }
            },
            "default_host_name": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
