# Non-secret runtime settings. The service account's bind password is
# NOT set here — it lives in Vault at the path referenced by the
# integration record's credentials_ref, per FR-INT-003.

AD_LDAP_SERVER=dc01.corp.example.com
AD_LDAP_PORT=636
AD_USE_SSL=true
AD_BIND_DN=CN=svc-aev-sync,OU=Service Accounts,DC=corp,DC=example,DC=com
AD_BASE_DN=DC=corp,DC=example,DC=com

VAULT_ADDR=https://vault.internal.aev-platform.com
VAULT_CREDENTIALS_REF=secret/data/integrations/active-directory/<integration_id>

BETA_ASSET_INGEST_URL=https://beta.internal.aev-platform.com/api/v1/assets/ingest
