# Non-secret runtime settings. The client_secret itself is NOT set here —
# it lives in Vault at the path referenced by the integration record's
# credentials_ref, per FR-INT-003.

DEFENDER_TENANT_ID=11111111-1111-1111-1111-111111111111
DEFENDER_CLIENT_ID=22222222-2222-2222-2222-222222222222
DEFENDER_API_BASE_URL=https://api.securitycenter.microsoft.com/
DEFENDER_LOGIN_BASE_URL=https://login.microsoftonline.com/

VAULT_ADDR=https://vault.internal.aev-platform.com
VAULT_CREDENTIALS_REF=secret/data/integrations/microsoft-defender/<integration_id>

BETA_ASSET_INGEST_URL=https://beta.internal.aev-platform.com/api/v1/assets/ingest
BETA_EXPOSURE_INGEST_URL=https://beta.internal.aev-platform.com/api/v1/exposures/ingest
