# Copy this file to .env and set your local values.

# AI providers
GOOGLE_API_KEY=
COLAB_GEMMA_URL=

# Database credentials
POSTGRES_DB=aevdb
POSTGRES_USER=aev
POSTGRES_PASSWORD=replace_with_a_strong_unique_password

# Local host connection URLs
REDIS_URL=redis://localhost:6380
DATABASE_URL=postgresql://aev:replace_with_a_strong_unique_password@localhost:5433/aevdb

# AI Context service for natural-language asset search.
# Leave empty to use the local demo asset list.
AI_CONTEXT_URL=
AI_CONTEXT_TIMEOUT=3