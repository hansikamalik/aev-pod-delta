# AI Gateway Environment Configuration Example
# Copy this file to .env and fill in your values

# Colab Gemma GPU URL (temporary - add only in .env, never commit to git)
COLAB_GEMMA_URL=

# Google AI Studio API Key (free, permanent - https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# Redis & Database
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://aev:secret@localhost:5432/aevdb