# ==============================================================================
# AEV Pod Delta (Module 4 Backend) Environment Configuration
# Copy this file to .env and configure values before starting services.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Gateway & LLM Orchestration
# ------------------------------------------------------------------------------
# Google Gemini / Gemma API Key (get from https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GOOGLE_MODEL=gemma-4-31b-it

# JWT Authentication & Cryptographic Trust Boundary (P1-1)
JWT_SECRET=your-minimum-32-character-secret-key-goes-here
JWT_ALGORITHM=HS256

# Alerting Webhooks for Spend & System Breaches (P1-3)
SLACK_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXX
PAGERDUTY_ALERT_WEBHOOK_URL=https://events.pagerduty.com/v2/enqueue

# Internal AI Context Service Connection
AI_CONTEXT_URL=http://ai-context:8001
AI_CONTEXT_TOKEN=aev-internal-service-token-32chars-min
AI_CONTEXT_TIMEOUT=5

# ------------------------------------------------------------------------------
# 2. Database & Vector Storage (PostgreSQL 15 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_DB=aevdb
POSTGRES_USER=aev
POSTGRES_PASSWORD=secret
DATABASE_URL=postgresql://aev:secret@postgres:5432/aevdb

# ------------------------------------------------------------------------------
# 3. Redis Caching & Distributed Locking (P1-2)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. AI Context Service Configuration
# ------------------------------------------------------------------------------
AEV_DATA_SOURCE=database
AEV_API_KEYS_JSON={"aev-internal-service-token-32chars-min":{"user_id":"admin","role":"admin"}}
