# ==============================================================================
# AEV Pod Delta (Module 4 Backend) Environment Configuration
# ==============================================================================

# 1. Google Gemini / Gemma AI Configuration
# Get an API key from https://aistudio.google.com/
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GOOGLE_MODEL=gemma-4-31b-it

# 2. Live PostgreSQL Audit Database Configuration
DATABASE_URL=postgresql://aev:secret@localhost:5432/aevdb
POSTGRES_DB=aevdb
POSTGRES_USER=aev
POSTGRES_PASSWORD=secret

# 3. Optional Redis Caching
REDIS_URL=redis://localhost:6379
